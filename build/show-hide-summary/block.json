{
	"$schema": "https://json.schemastore.org/block.json",
	"apiVersion": 2,
	"name": "happyprime/show-hide-summary",
	"title": "Show Hide Summary",
	"textdomain": "show-hide-section-block",
	"category": "widgets",
	"description": "The summary element in a details section.",
	"icon": "media-document",
	"parent": [ "happyprime/show-hide-section" ],
	"attributes": {
		"summary": {
			"type": "string",
			"source": "html",
			"selector": "summary"
		}
	},
	"supports": {
		"anchor": true,
		"align": true,
		"alignWide": true,
		"color": {
			"background": true,
			"enableContrastChecker": true,
			"text": true,
			"link": true,
			"gradients": true
		},
		"defaultStylePicker": true,
		"dimensions": {
			"minHeight": true
		},
		"html": false,
		"multiple": true,
		"position": {
			"sticky": false
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		}
	},
	"editorScript": "file:index.js"
}
