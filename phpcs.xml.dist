<?xml version="1.0"?>
<ruleset name="Show / Hide Section Block">
	<description>Happy Prime coding standards for Show / Hide Section Block.</description>

	<file>plugin.php</file>
	<file>src</file>

	<rule ref="HappyPrime"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="show-hide-section-block"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="HappyPrime\Blocks"/>
				<element value="HP_SHS"/>
			</property>
		</properties>
	</rule>
</ruleset>
